rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Règles pour les utilisateurs
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Sous-collections SRS
      match /srsSettings/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /srsExercises/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /srsReviews/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Autres sous-collections
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Leçons : lecture publique, écriture interdite depuis l'app.
    // Le contenu se modifie via la console Firebase ou un script Admin SDK
    // (qui contourne ces règles).
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Achievements : lecture publique, écriture réservée à l'admin
    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
